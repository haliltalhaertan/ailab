OPENROUTER_API_KEY=sk-or-v1-...
LAB_MODEL=openai/gpt-4o-mini

# Tek prompttan yeni proje taslağı oluşturan ProjectPlanner.
# Arayüzde gelişmiş ayarlardan da değiştirilebilir.
LAB_PROJECT_PLANNER_MODEL=openai/gpt-4o-mini

# Theorem Research Lab v2 varsayılanları.
# Streamlit arayüzünde her agent için modeli ayrıca seçebilirsin; aşağıdakiler sadece başlangıç değeridir.
LAB_MANAGER_MODEL=openai/gpt-4o
LAB_PROPOSER_MODEL=deepseek/deepseek-r1
LAB_CRITIC_MODEL=anthropic/claude-3.5-sonnet
LAB_VERIFIER_MODEL=openai/gpt-4o
LAB_LITERATURE_MODEL=openai/gpt-4o-mini
LAB_AUDITOR_MODEL=google/gemini-2.0-flash-001
# LAB_LITERATURE_QUERY=tropical circuit reachability provenance lower bound
