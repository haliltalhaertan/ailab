OPENROUTER_API_KEY=sk-or-v1-...
LAB_MODEL=z-ai/glm-5.3-flash

# Tek prompttan yeni proje taslağı oluşturan ProjectPlanner.
# Arayüzde gelişmiş ayarlardan da değiştirilebilir.
LAB_PROJECT_PLANNER_MODEL=z-ai/glm-5.3-flash

# Theorem Research Lab varsayılanları.
# Streamlit arayüzünde her agent için modeli ayrıca seçebilirsin; aşağıdakiler sadece başlangıç değeridir.
LAB_MANAGER_MODEL=z-ai/glm-5.3-flash
LAB_PROPOSER_MODEL=deepseek/deepseek-v4-pro
LAB_CRITIC_MODEL=moonshotai/kimi-k2.5
LAB_VERIFIER_MODEL=google/gemini-3.7-flash
LAB_LITERATURE_MODEL=z-ai/glm-5.3-flash
LAB_AUDITOR_MODEL=google/gemini-3.7-flash
# LAB_LITERATURE_QUERY=tropical circuit reachability provenance lower bound

# Opsiyonel tek global acil güvenlik tavanı. Varsayılan olarak KAPALIdır.
# Rol bazlı bütçe değildir; agent promptlarına yazılmaz ve normal araştırmayı kısaltmak için kullanılmaz.
# Yalnız runaway maliyete karşı operatör güvenlik freni gerektiğinde aç.
# LAB_EMERGENCY_MAX_TOKENS=50000
